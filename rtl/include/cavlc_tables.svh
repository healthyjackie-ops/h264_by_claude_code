// chroma DC total_zeros: {valid, tz[1:0], len[1:0]}
function automatic logic [4:0] cavlc_cdc_total_zeros(
    input logic [1:0] tc_m1, input logic [2:0] win);
  logic [4:0] r;
  r = '0;
  unique case (tc_m1)
    2'd0: casez (win)
      3'b001: r = {1'b1, 2'd2, 2'd3};
      3'b000: r = {1'b1, 2'd3, 2'd3};
      3'b01?: r = {1'b1, 2'd1, 2'd2};
      3'b1??: r = {1'b1, 2'd0, 2'd1};
      default: r = '0;
    endcase
    2'd1: casez (win)
      3'b01?: r = {1'b1, 2'd1, 2'd2};
      3'b00?: r = {1'b1, 2'd2, 2'd2};
      3'b1??: r = {1'b1, 2'd0, 2'd1};
      default: r = '0;
    endcase
    2'd2: casez (win)
      3'b1??: r = {1'b1, 2'd0, 2'd1};
      3'b0??: r = {1'b1, 2'd1, 2'd1};
      default: r = '0;
    endcase
    default: r = '0;
  endcase
  return r;
endfunction

